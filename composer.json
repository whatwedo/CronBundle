{
    "name": "whatwedo/cron-bundle",
    "type": "symfony-bundle",
    "description": "Run Symfony commands as cron job",
    "license": "MIT",
    "homepage": "https://doc.whatwedo.ch/whatwedo/cronbundle",
    "authors": [
        {
            "name": "Felix Imobersteg",
            "email": "felix@whatwedo.ch"
        },
        {
            "name": "Felix Ammann",
            "email": "fexu@whatwedo.ch"
        },
        {
            "name": "whatwedo GmbH",
            "email": "welove@whatwedo.ch"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-posix": "*",
        "dragonmantank/cron-expression": "~3.3",
        "symfony/console": "^6.4|^7.1|^8.0",
        "symfony/event-dispatcher": "^6.4|^7.1|^8.0",
        "symfony/framework-bundle": "^6.4|^7.1|^8.0",
        "symfony/process": "^6.4|^7.1|^8.0",
        "symfony/security-bundle": "^6.4|^7.1|^8.0",
        "symfony/yaml": "^6.4|^7.1|^8.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.13|^3.0",
        "doctrine/orm": "^2.20|^3.3",
        "phpunit/phpunit": "^11.5|^12.0",
        "symfony/browser-kit": "^6.4|^7.4|^8.0",
        "symfony/css-selector": "^6.4|^7.4|^8.0",
        "symfony/http-kernel": "^6.4|^7.4|^8.0",
        "symfony/config": "^6.4|^7.4|^8.0",
        "symfony/dependency-injection": "^6.4|^7.4|^8.0",
        "symfony/validator": "^6.4|^7.4|^8.0",
        "symfony/translation": "^6.4|^7.4|^8.0",
        "symfony/twig-bundle": "^6.4|^7.4|^8.0",
        "symfony/runtime": "^6.4|^7.4|^8.0",
        "symfony/dotenv": "^6.4|^7.4|^8.0",
        "whatwedo/php-coding-standard": "^2.0",
        "whatwedo/twig-bootstrap-icons": "^1.0",
        "zenstruck/console-test": "^1.8",
        "zenstruck/browser": "^1.10",
        "phpstan/phpstan": "^2.1",
        "symfony/stimulus-bundle": "^2.16|^3.0"
    },
    "conflict": {
        "doctrine/doctrine-bundle": "<2.8",
        "doctrine/orm": "<2.13"
    },
    "suggest": {
        "symfony/stimulus-bundle": "^2.16|^3.0",
        "symfony/webpack-encore-bundle": "^1.14|^2.1"
    },
    "autoload": {
        "psr-4": {
            "whatwedo\\CronBundle\\": "src/",
            "whatwedo\\CronBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
